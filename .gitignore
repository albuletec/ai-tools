.idea
.vscode
.DS_Store

# Local ait installs land here when you run the wizard from inside this repo.
# Tracking them would dirty the tree and make `ait`'s --ff-only auto-pull fail.
.claude/
.github/agents/
.github/skills/
.cursor/
.windsurf/

# What `ait init` writes when it is run from inside this repo. Each pattern is
# anchored to the repo root, so the templates under claude-code/init/,
# copilot/init/, cursor/init/ and windsurf/init/ stay tracked.
/CLAUDE.md
/AGENTS.md
/.github/copilot-instructions.md

# Standards repos cloned locally for context
workspace/

# Plans generated by the code-planner agent
docs/plans/
